# Vault Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to version control

# Master encryption password for the application
# Use a strong, unique password (16+ characters recommended)
VAULT_PASSWORD=your-secure-password-here

# Encryption keys for different data classifications
# Rotate these periodically for security
VAULT_KEY_PRODUCTION=production-encryption-key
VAULT_KEY_STAGING=staging-encryption-key
VAULT_KEY_DEVELOPMENT=development-encryption-key

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
VAULT_LOG_LEVEL=INFO

# Enable verbose logging for debugging
VAULT_DEBUG=false

# Directory for encrypted files (optional, defaults to current directory)
VAULT_ENCRYPTED_DIR=./encrypted

# Default password for CLI operations (use with caution)
# If set, vault will use this instead of prompting
# NOT RECOMMENDED for production
VAULT_DEFAULT_PASSWORD=

# Enable automatic backup before encryption
VAULT_AUTO_BACKUP=true

# Backup directory location
VAULT_BACKUP_DIR=./backups

# Maximum file size for encryption in bytes (0 = unlimited)
# Default: 0 (no limit)
VAULT_MAX_FILE_SIZE=0

# Number of PBKDF2 iterations for key derivation
# Higher = more secure but slower
# Default: 480000
VAULT_PBKDF2_ITERATIONS=480000

# Enable audit logging (logs all encryption/decryption operations)
VAULT_AUDIT_LOG=false

# Audit log file path
VAULT_AUDIT_LOG_PATH=./logs/audit.log
